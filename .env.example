# LineageBox's settings for docker compose. Copy this file to .env next to compose.yaml; it works as it is, with your
# photos in ./photos. Lines starting with # are off. docs/install.md and docs/configuration.md explain each one.

# ---- On this machine
# The one folder that holds all your photos and videos (in folders of their own inside it, as you like). It appears
# in LineageBox as "local". e.g. /volume1/photo on a NAS. In several places? docs/install.md#a-folder-of-this-machine
# It must be there already, as must DATA's folder: Docker would make a missing one as root.
PHOTOS=./photos
# The catalog (database, thumbnails, previews: about 0.5 MB per photo). On this machine's own disk, never a share.
DATA=./data
# The web UI's port on this machine
PORT=8000
# Answer only on one of this machine's addresses (e.g. 192.168.1.5), not on all of them. IPv4 only.
#BIND=0.0.0.0
# Time zone, for the describing hours and the dates shown, e.g. America/Denver or Europe/Berlin
TZ=UTC
# The user and group LineageBox runs as: whoever owns the photos and the catalog folder (`id -u` and `id -g` for
# you). What LineageBox writes belongs to them. 0 for rootless Docker or Podman. docs/install.md#users-and-permissions
PUID=1000
PGID=1000

# ---- The heavy work: Ollama (descriptions) and Whisper (transcripts). See docs/ollama.md and docs/whisper.md.
# Unset, LineageBox looks for Ollama on this machine (http://host.docker.internal:11434) and uses no Whisper.
# On another machine: its address.
#OLLAMA_URL=http://192.168.1.10:11434
#WHISPER_URL=http://192.168.1.10:9300
# Or here, in Docker: add their compose files to COMPOSE_FILE (below), and leave the addresses above unset.
#OLLAMA_NUM_PARALLEL=1
#WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
# The language spoken in the videos (en, de, ...), or auto. Default: en
#WHISPER_LANGUAGE=en
# Whose photos these are: helps the AI read the places in folder names
#LIBRARY_ABOUT=a family in Oregon, USA

# ---- Extra compose files, separated by ":" (";" on Windows); compose.yaml comes first.
#   compose.ollama.yaml          Ollama in Docker (+ compose.ollama-nvidia.yaml or compose.ollama-amd.yaml for a GPU)
#   compose.whisper.yaml         Whisper in Docker, on the processor
#   compose.smb.yaml             a network share as another source (below)
#   compose.override.yaml        your own changes, if you have one: it is only read by itself while this is unset
#COMPOSE_FILE=compose.yaml:compose.ollama.yaml:compose.whisper.yaml

# ---- A network share as another source: "nas" in LineageBox
#SMB_SHARE=//192.168.1.20/photos
#SMB_USERNAME=me
#SMB_PASSWORD='in single quotes; no commas'
#SMB_VERSION=3.0

# ---- Reaching it (the Settings page changes all of these but ALLOWED_NETWORKS: these are starting values)
# Where people's PCs find each source, for "Copy network path": name=path, separated by commas
#NETWORK_PATHS=local=\\mynas\photo,nas=\\192.168.1.20\photos
# Who may use it. Default: every private network
#ALLOWED_NETWORKS=192.168.1.0/24
# Names to answer to besides addresses and home-network names (nas, photos.lan): yours, for HTTPS
#ALLOWED_HOSTS=photos.example.com
# The reverse proxy in front of it (for HTTPS): its address or network, so the clients behind it are checked
#TRUSTED_PROXIES=172.18.0.3
# HTTPS without a reverse proxy: the certificate and key, as the container sees them
#TLS_CERT=/data/certs/fullchain.pem
#TLS_KEY=/data/certs/privkey.pem

# ---- Which LineageBox: the newest release, which the Status page's Update now installs; or one release, kept as it is
#LINEAGEBOX_VERSION=1.2.3
# Another image, such as a fork's: its name, without the version
#LINEAGEBOX_IMAGE=ghcr.io/mutilator/lineagebox
# Docker's socket, for the updater service (rootless Docker: /run/user/1000/docker.sock)
#DOCKER_SOCKET=/var/run/docker.sock
